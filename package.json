{
  "name": "tunes",
  "version": "1.0.0",
  "description": "Self-hosted music player with no subscription: your local library plus free, legal sources (Audius, Internet Archive, internet radio, synced lyrics)",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "music-metadata": "^12.8.0",
    "qrcode": "^1.5.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajdinl/tunes.git"
  },
  "keywords": [
    "music",
    "music-player",
    "self-hosted",
    "audius",
    "internet-archive",
    "radio",
    "lyrics",
    "listenbrainz"
  ],
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "vitest": "^4.1.12"
  }
}
