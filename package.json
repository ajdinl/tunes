{
  "name": "tunes",
  "version": "1.0.0",
  "description": "Self-hosted music player with no subscription: your local library plus free, legal sources (Audius, Internet Archive, internet radio, synced lyrics)",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "prestart": "vite build --logLevel warn",
    "start": "node server.ts",
    "dev": "vite",
    "build": "vite build",
    "test": "npm run typecheck && npm run build && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "music-metadata": "^12.8.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^7.3.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ajdinl/tunes.git"
  },
  "keywords": [
    "music",
    "music-player",
    "self-hosted",
    "audius",
    "internet-archive",
    "radio",
    "lyrics",
    "listenbrainz"
  ],
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
